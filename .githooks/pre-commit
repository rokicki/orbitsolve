#!/bin/bash
# reject files over 5 MB and Mach-O binaries (big data and builds stay out of git; see SYNC.md)
bad=0
while IFS= read -r -d '' f; do
  [ -f "$f" ] || continue
  s=$(stat -f %z "$f" 2>/dev/null || stat -c %s "$f")
  if [ "$s" -gt 5000000 ]; then echo "pre-commit: $f is $s bytes (over 5 MB); add it to .gitignore" >&2; bad=1; fi
  if file -b "$f" | grep -q -e Mach-O -e ELF; then echo "pre-commit: $f is a binary; add it to .gitignore" >&2; bad=1; fi
done < <(git diff --cached --name-only --diff-filter=AM -z)
exit $bad
